---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Slate Sheet — SlateDocs" activeApp="excel">

  <div class="flex-1 flex items-center justify-center py-16 px-4">
    <div class="text-center animate-fade-in max-w-md px-4">

      <!-- Excel Table Icon -->
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-excel text-white shadow-lg shadow-excel/20 mb-6 mx-auto">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M3 9h18"/>
          <path d="M3 15h18"/>
          <path d="M9 3v18"/>
          <path d="M15 3v18"/>
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2 tracking-tight">Slate Sheet Editor</h1>
      <p class="text-sm text-slate-600 dark:text-zinc-400 mb-6 leading-relaxed">
        The Slate Sheet-style spreadsheet editor is <span class="font-semibold text-excel dark:text-emerald-400">coming soon</span>.
        Build formulas, charts, and pivot tables right in your browser.
      </p>

      <!-- Feature Preview Pills -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#EDF6F0] dark:bg-excel/20 text-excel dark:text-emerald-300 text-xs font-medium">
          Cell Grid Engine
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#EDF6F0] dark:bg-excel/20 text-excel dark:text-emerald-300 text-xs font-medium">
          Formula Bar
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#EDF6F0] dark:bg-excel/20 text-excel dark:text-emerald-300 text-xs font-medium">
          Charts
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#EDF6F0] dark:bg-excel/20 text-excel dark:text-emerald-300 text-xs font-medium">
          .xlsx Export
        </span>
      </div>

      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-excel text-white text-sm font-semibold transition-all duration-200 hover:bg-excel/90 hover:shadow-lg active:scale-[0.98]"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 2L3 7l5 5M3 7h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Dashboard
      </a>
    </div>
  </div>

</AppLayout>
