---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Slate Slide — SlateDocs" activeApp="powerpoint">

  <div class="flex-1 flex items-center justify-center py-16 px-4">
    <div class="text-center animate-fade-in max-w-md px-4">

      <!-- PowerPoint Slide Icon -->
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-powerpoint text-white shadow-lg shadow-powerpoint/20 mb-6 mx-auto">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h20"/>
          <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/>
          <path d="m7 21 5-5 5 5"/>
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2 tracking-tight">Slate Slide Editor</h1>
      <p class="text-sm text-slate-600 dark:text-zinc-400 mb-6 leading-relaxed">
        The Slate Slide-style presentation editor is <span class="font-semibold text-powerpoint dark:text-orange-400">coming soon</span>.
        Design stunning slides with animations and transitions.
      </p>

      <!-- Feature Preview Pills -->
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#FCEEE9] dark:bg-powerpoint/20 text-powerpoint dark:text-orange-300 text-xs font-medium">
          Slide Canvas
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#FCEEE9] dark:bg-powerpoint/20 text-powerpoint dark:text-orange-300 text-xs font-medium">
          Transitions
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#FCEEE9] dark:bg-powerpoint/20 text-powerpoint dark:text-orange-300 text-xs font-medium">
          Presenter View
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-[#FCEEE9] dark:bg-powerpoint/20 text-powerpoint dark:text-orange-300 text-xs font-medium">
          .pptx Export
        </span>
      </div>

      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-powerpoint text-white text-sm font-semibold transition-all duration-200 hover:bg-powerpoint/90 hover:shadow-lg active:scale-[0.98]"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M8 2L3 7l5 5M3 7h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Dashboard
      </a>
    </div>
  </div>

</AppLayout>
