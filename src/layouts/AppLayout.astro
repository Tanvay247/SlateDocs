---
import '../styles/global.css';

interface Props {
  title?: string;
  activeApp?: 'dashboard' | 'word' | 'excel' | 'powerpoint';
}

const { title = 'SlateDocs', activeApp = 'dashboard' } = Astro.props;

const navItems = [
  { id: 'dashboard' as const, label: 'Home', href: '/', color: '#0078D4' },
  { id: 'word' as const, label: 'Slate Doc', href: '/word', color: '#2B579A' },
  { id: 'excel' as const, label: 'Slate Sheet', href: '/excel', color: '#217346' },
  { id: 'powerpoint' as const, label: 'Slate Slide', href: '/powerpoint', color: '#D24726' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="SlateDocs — A modern web-based office suite featuring Slate Doc, Slate Sheet, and Slate Slide." />
  <meta name="theme-color" content="#0078D4" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <!-- Synchronous Anti-FOUC Script to restore dark class before initial render -->
  <script is:inline>
  {
    const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  }
  </script>
</head>
<body class="min-h-dvh bg-[#F5F4F0] dark:bg-[#212121] text-slate-900 dark:text-slate-100 flex flex-col transition-colors duration-200">

  <!-- ========== TITLE BAR / NAVBAR (FULL EDGE-TO-EDGE) ========== -->
  {activeApp !== 'word' && (
    <header
      class="sticky top-0 z-50 flex items-center justify-between h-14 w-full px-4 sm:px-6 lg:px-8 border-b border-[#E5E3DC] shadow-sm dark:bg-[#2A2A2A]/90 dark:border-[#3A3A3A] dark:shadow-none bg-[#FAF9F6]/90 backdrop-blur-md transition-colors duration-200"
      role="banner"
    >
      <!-- Left Side: Logo & App Switcher Nav -->
      <div class="flex items-center gap-6 sm:gap-8">
        <!-- Logo & Brand -->
        <a
          href="/"
          class="flex items-center gap-2.5 text-slate-900 dark:text-slate-100 no-underline group"
          aria-label="SlateDocs Home"
        >
          <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[#0078D4] text-white transition-transform duration-200 group-hover:scale-105 shadow-sm">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="1" y="1" width="6" height="6" rx="1" fill="white" opacity="0.9"/>
              <rect x="9" y="1" width="6" height="6" rx="1" fill="white" opacity="0.7"/>
              <rect x="1" y="9" width="6" height="6" rx="1" fill="white" opacity="0.7"/>
              <rect x="9" y="9" width="6" height="6" rx="1" fill="white" opacity="0.5"/>
            </svg>
          </div>
          <span class="text-base font-bold tracking-tight hidden sm:inline">SlateDocs</span>
        </a>

        <!-- App Switcher Nav -->
        <nav class="flex items-center gap-1.5" role="navigation" aria-label="Application switcher">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'relative flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200',
                activeApp === item.id
                  ? 'text-[#0078D4] bg-[#EBF4FC] dark:bg-sky-950/50 dark:text-sky-400 font-semibold'
                  : 'text-slate-700 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-[#EFECE6] dark:hover:bg-[#333333]',
              ]}
              aria-current={activeApp === item.id ? 'page' : undefined}
            >
              {item.id === 'dashboard' && (
                <svg width="16" height="16" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="0.5" y="0.5" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="8" y="0.5" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="0.5" y="8" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="8" y="8" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              )}
              {item.id === 'word' && (
                <svg class="text-[#2B579A] dark:text-blue-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <line x1="10" y1="9" x2="8" y2="9"/>
                </svg>
              )}
              {item.id === 'excel' && (
                <svg class="text-[#217346] dark:text-emerald-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2"/>
                  <path d="M3 9h18"/>
                  <path d="M3 15h18"/>
                  <path d="M9 3v18"/>
                  <path d="M15 3v18"/>
                </svg>
              )}
              {item.id === 'powerpoint' && (
                <svg class="text-[#D24726] dark:text-orange-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h20"/>
                  <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"/>
                  <path d="m7 21 5-5 5 5"/>
                </svg>
              )}
              <span class="hidden sm:inline">{item.label}</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- Right Side: Status, Dark Mode Toggle & User Avatar -->
      <div class="flex items-center gap-3 sm:gap-4">
        <!-- Cloud Status -->
        <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-zinc-400" aria-label="Cloud status: Saved">
          <svg width="16" height="16" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11.083 6.417a3.5 3.5 0 0 0-6.72-1.05A2.917 2.917 0 0 0 4.667 11.083h6.125a2.333 2.333 0 0 0 .291-4.666Z" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5.25 7.583 6.417 8.75 8.75 6.417" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-mono text-xs hidden md:inline">Saved</span>
        </div>

        <!-- Divider -->
        <div class="w-px h-6 bg-[#E5E3DC] dark:bg-[#3A3A3A]" aria-hidden="true"></div>

        <!-- Dark Mode Toggle Button -->
        <button
          type="button"
          id="theme-toggle"
          class="relative flex items-center justify-center w-9 h-9 rounded-lg text-slate-700 dark:text-zinc-400 transition-all duration-200 hover:bg-[#EFECE6] dark:hover:bg-[#333333] hover:text-slate-900 dark:hover:text-slate-100 active:scale-90"
          aria-label="Toggle dark mode"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg
            id="icon-sun"
            class="w-4.5 h-4.5 absolute transition-all duration-300 opacity-0 rotate-90 scale-0"
            viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.3"/>
            <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.17 3.17l1.06 1.06M11.77 11.77l1.06 1.06M3.17 12.83l1.06-1.06M11.77 4.23l1.06-1.06" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg
            id="icon-moon"
            class="w-4.5 h-4.5 absolute transition-all duration-300"
            viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d="M14 9.68A6.5 6.5 0 0 1 6.32 2 6.5 6.5 0 1 0 14 9.68Z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Divider -->
        <div class="w-px h-6 bg-[#E5E3DC] dark:bg-[#3A3A3A]" aria-hidden="true"></div>

        <!-- User Avatar -->
        <button
          type="button"
          class="flex items-center justify-center w-8 h-8 rounded-full bg-[#0078D4] text-white text-xs font-bold transition-transform duration-200 hover:scale-105 active:scale-95 shadow-sm"
          aria-label="User menu"
        >
          U
        </button>
      </div>
    </header>
  )}

  <!-- ========== MAIN CONTENT ========== -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- ========== SLEEK COMPACT ENTERPRISE FOOTER ========== -->
  {activeApp !== 'word' && (
    <footer class="mt-auto border-t border-[#E5E3DC] dark:border-[#3A3A3A] bg-[#FAF9F6] dark:bg-[#2A2A2A] py-4 transition-colors duration-200" role="contentinfo">
      <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600 dark:text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-slate-900 dark:text-slate-200">SlateDocs</span>
          <span>&copy; {new Date().getFullYear()} SlateDocs Suite. All rights reserved.</span>
        </div>
        <nav class="flex items-center gap-4 sm:gap-6 font-medium">
          <a href="#" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors duration-150">Templates</a>
          <a href="#" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors duration-150">About</a>
          <a href="#" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors duration-150">Privacy</a>
          <a href="#" class="hover:text-slate-900 dark:hover:text-slate-100 transition-colors duration-150">Terms</a>
        </nav>
      </div>
    </footer>
  )}

  <!-- Dark Mode Toggle Script -->
  <script is:inline>
  {
    const btn = document.getElementById("theme-toggle");
    const iconSun = document.getElementById("icon-sun");
    const iconMoon = document.getElementById("icon-moon");

    function syncThemeUI() {
      if (!iconSun || !iconMoon) return;
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        iconSun.classList.remove("opacity-0", "rotate-90", "scale-0");
        iconSun.classList.add("opacity-100", "rotate-0", "scale-100");
        iconMoon.classList.add("opacity-0", "-rotate-90", "scale-0");
        iconMoon.classList.remove("opacity-100", "rotate-0", "scale-100");
      } else {
        iconMoon.classList.remove("opacity-0", "-rotate-90", "scale-0");
        iconMoon.classList.add("opacity-100", "rotate-0", "scale-100");
        iconSun.classList.add("opacity-0", "rotate-90", "scale-0");
        iconSun.classList.remove("opacity-100", "rotate-0", "scale-100");
      }
    }

    btn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      syncThemeUI();
    });

    syncThemeUI();
  }
  </script>

</body>
</html>
